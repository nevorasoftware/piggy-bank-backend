// Prisma Schema para PiggyBank - Casino & Sorteos El Salvador
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum RoomStatus {
  ABIERTA
  LLENA
  CERRADA
  SORTEANDO
  FINALIZADA
}

enum TicketStatus {
  ACTIVO
  GANADOR
  NO_GANADOR
  CANCELADO
}

enum TransactionStatus {
  PENDING
  APPROVED
  DECLINED
  VOIDED
  ERROR
  REJECTED_OVERLIMIT
}

enum VerificationType {
  EMAIL
  WHATSAPP
}

enum AccountType {
  AHORRO
  CORRIENTE
}

enum PayoutStatus {
  PENDIENTE
  PAGADO
}

model User {
  id                String             @id @default(uuid())
  fullName          String
  email             String             @unique
  phone             String             @unique
  dui               String             @unique // Formato: 00000000-0
  password          String
  role              Role               @default(USER)
  emailVerified     Boolean            @default(false)
  phoneVerified     Boolean            @default(false)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  bankAccount       BankAccount?
  tickets           Ticket[]
  transactions      Transaction[]
  dailyStats        DailyUserStats[]
  verificationCodes VerificationCode[]
  sorteosGanados    Sorteo[]

  @@map("users")
}

model BankAccount {
  id            String      @id @default(uuid())
  userId        String      @unique
  bankName      String
  accountType   AccountType @default(AHORRO)
  accountNumber String
  accountHolder String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user          User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bank_accounts")
}

model Room {
  id             String        @id @default(uuid())
  nombre         String
  premio         Decimal       @db.Decimal(10, 2)
  costoPase      Decimal       @db.Decimal(10, 2)
  capacidadMax   Int
  duracionHoras  Int           @default(2) // Duración parametrizada en horas
  horaApertura   DateTime      @default(now())
  horaSorteo     DateTime
  estado         RoomStatus    @default(ABIERTA)
  ticketsSold    Int           @default(0)
  winnerUserId   String?
  winnerTicketId String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  tickets       Ticket[]
  sorteo        Sorteo?
  transactions  Transaction[]

  @@map("rooms")
}

model Ticket {
  id            String        @id @default(uuid())
  ticketNumber  String
  roomId        String
  userId        String
  transactionId String?
  precio        Decimal       @db.Decimal(10, 2)
  estado        TicketStatus  @default(ACTIVO)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  room          Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction   Transaction?  @relation(fields: [transactionId], references: [id])

  @@unique([roomId, ticketNumber])
  @@map("tickets")
}

model Transaction {
  id                 String            @id @default(uuid())
  userId             String
  roomId             String?
  wompiTransactionId String?
  wompiReference     String            @unique
  amount             Decimal           @db.Decimal(10, 2)
  currency           String            @default("USD")
  status             TransactionStatus @default(PENDING)
  paymentMethod      String?
  metadata           Json?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  user               User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  room               Room?             @relation(fields: [roomId], references: [id])
  tickets            Ticket[]

  @@map("transactions")
}

model VerificationCode {
  id         String           @id @default(uuid())
  userId     String?
  identifier String           // Email o Teléfono
  type       VerificationType
  code       String           // Código de 6 dígitos
  expiresAt  DateTime
  used       Boolean          @default(false)
  createdAt  DateTime         @default(now())

  user       User?            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([identifier, code, used])
  @@map("verification_codes")
}

model Sorteo {
  id              String       @id @default(uuid())
  roomId          String       @unique
  ganadorUserId   String
  ticketGanadorId String
  montoPremio     Decimal      @db.Decimal(10, 2)
  fechaSorteo     DateTime     @default(now())
  estadoPago      PayoutStatus @default(PENDIENTE)
  fechaPago       DateTime?
  notasPago       String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  room            Room         @relation(fields: [roomId], references: [id], onDelete: Cascade)
  ganador         User         @relation(fields: [ganadorUserId], references: [id])

  @@map("sorteos")
}

model GameConfig {
  id                    Int      @id @default(1)
  maxParticipacionesDia Int      @default(6)
  maxVictoriasDia       Int      @default(3)
  updatedAt             DateTime @updatedAt

  @@map("game_configs")
}

model DailyUserStats {
  id              String   @id @default(uuid())
  userId          String
  fecha           String   // Formato YYYY-MM-DD en America/El_Salvador
  participaciones Int      @default(0)
  victorias       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fecha])
  @@index([userId, fecha])
  @@map("daily_user_stats")
}

model PaymentConfig {
  id             Int      @id @default(1)
  wompiAppId     String   @default("ba6ddd9d-e5d4-4c73-8571-9c3fde2f31e2")
  wompiApiSecret String   @default("4dbf191f-c328-4a98-af50-c85a6722a599")
  wompiAuthUrl   String   @default("https://id.wompi.sv/connect/token")
  wompiApiUrl    String   @default("https://api.wompi.sv")
  isLive         Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  @@map("payment_configs")
}

