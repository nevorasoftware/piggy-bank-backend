# ========================================================
# PIGGY BANK BACKEND - VARIABLES DE ENTORNO (RAILWAY)
# ========================================================

# Puerto del servidor (Asignado automáticamente en Railway vía $PORT)
PORT=3000
NODE_ENV=production

# Base de Datos PostgreSQL (Inyectada automáticamente por el plugin de PostgreSQL de Railway)
DATABASE_URL=postgresql://postgres:password@localhost:5432/piggybank?schema=public

# Seguridad y Autenticación JWT
JWT_SECRET=super_secret_jwt_key_piggy_bank_2026_change_in_production
JWT_EXPIRES_IN=7d

# Wompi El Salvador (https://docs.wompi.sv/)
WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=events_sec_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_BASE_URL=https://production.wompi.sv
# Para pruebas se puede usar: https://sandbox.wompi.sv

# WhatsApp Business Cloud API (Meta Developers)
WHATSAPP_TOKEN=EAAG...tu_token_permanente_o_temporal_meta
WHATSAPP_PHONE_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=piggy_bank_meta_webhook_verify_token_2026

# URLs de Comunicación y CORS
FRONTEND_URL=https://piggy-bank-frontend.up.railway.app
BACKEND_PUBLIC_URL=https://piggy-bank-backend.up.railway.app

# Zona Horaria Oficial para El Salvador (Reglas de Reseteo y Sorteos)
TZ=America/El_Salvador
